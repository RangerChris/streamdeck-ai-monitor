{
	"Name": "AI Monitor",
	"Version": "0.3.0.0",
	"Author": "Kresten Elleby",
	"Actions": [
		{
			"Name": "Ollama Balance",
			"UUID": "com.segment7.aimonitor.ollama.balance",
			"Icon": "imgs/actions/ollama-balance/icon",
			"Tooltip": "Your remaining Ollama credit and how much you used.",
			"PropertyInspectorPath": "ui/ollama-balance.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/ollama-balance/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Live Tokens",
			"UUID": "com.segment7.aimonitor.claude.usage",
			"Icon": "imgs/actions/claude-usage/icon",
			"Tooltip": "AI tokens used with Claude Code today.",
			"PropertyInspectorPath": "ui/claude-usage.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/claude-usage/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Live Sessions",
			"UUID": "com.segment7.aimonitor.claude.sessions",
			"Icon": "imgs/actions/claude-sessions/icon",
			"Tooltip": "How many Claude Code sessions are live right now.",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/claude-sessions/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Current Model",
			"UUID": "com.segment7.aimonitor.claude.model",
			"Icon": "imgs/actions/claude-model/icon",
			"Tooltip": "The active Claude Code session's model and context fill.",
			"PropertyInspectorPath": "ui/current-model.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/claude-model/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Tree",
			"UUID": "com.segment7.aimonitor.grove",
			"Icon": "imgs/actions/grove/icon",
			"Tooltip": "A tree on this key that grows as you burn AI tokens; press to pick it.",
			"PropertyInspectorPath": "ui/grove.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/grove/key",
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Ollama Usage Info Bar",
			"UUID": "com.segment7.aimonitor.ollama.infobar",
			"Icon": "imgs/actions/ollama-infobar/icon",
			"Tooltip": "Your Ollama session and weekly usage as live bars.",
			"Controllers": [
				"Neo"
			],
			"States": [
				{
					"Image": "imgs/actions/ollama-infobar/key"
				}
			]
		}
	],
	"Category": "AI Monitor",
	"CategoryIcon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"Description": "Monitor AI usage: Ollama balance, Claude tokens, live sessions, and context fill.",
	"Icon": "imgs/plugin/marketplace",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.6"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"UUID": "com.segment7.aimonitor"
}
